# Regras específicas de cada projeto ficam em backend/.gitignore e
# frontend/.gitignore; aqui só o que vale pro repositório inteiro.

# Ambiente (.env fica na raiz; só o .env.example é versionado)
.env
.env.*
!.env.example

# IDE / SO
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store

# docs (notas locais, não versionadas)
docs/
