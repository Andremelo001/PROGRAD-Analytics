# Copie para .env e ajuste o que precisar. Nenhum valor aqui é segredo —
# são parâmetros de operação do pipeline de dados (ver README.md, seção 3).

# --- Ambiente e logging -----------------------------------------------------
ENV=local
LOG_LEVEL=INFO

# --- HTTP (download dos arquivos do INEP) -----------------------------------
HTTP_TIMEOUT=30.0
HTTP_USER_AGENT="PROGRAD-Analytics/0.1 (data pipeline)"
HTTP_MAX_RETRIES=3
HTTP_BACKOFF=2.0

# --- Módulo Qualidade (CPC) --------------------------------------------------
QUALIDADE_LANDING_URL=https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/indicadores-educacionais/indicadores-de-qualidade-da-educacao-superior
# < 2015 tem grão diferente (IES x Área, sem Código do Curso) — não mexer sem
# revisar o mapeamento de colunas em app/modules/qualidade/domain/schema.py
QUALIDADE_MIN_YEAR=2015
QUALIDADE_MAX_YEAR=2025

# --- Módulo Trajetória --------------------------------------------------------
TRAJETORIA_LANDING_URL=https://www.gov.br/inep/pt-br/acesso-a-informacao/dados-abertos/indicadores-educacionais/indicadores-de-trajetoria-da-educacao-superior
# Vazio = sem restrição, processa todas as faixas de anos encontradas na página.
TRAJETORIA_MIN_YEAR=
TRAJETORIA_MAX_YEAR=

# --- Exportação dos CSVs -----------------------------------------------------
# Acima deste tamanho (em MB) o CSV é gravado como .csv.gz em vez de .csv.
CSV_GZIP_THRESHOLD_MB=40

# --- Módulo Dashboard (recorta qualidade.csv + trajetoria.csv para 1 campus) -
# codigo_ies/codigo_municipio são os códigos do INEP/IBGE já presentes nos CSVs.
DASHBOARD_CODIGO_IES=583
DASHBOARD_CODIGO_MUNICIPIO=2311306
DASHBOARD_NOME_CAMPUS="UFC Campus Quixadá"
